SERVICE_NAME=agent-engine
PLATFORM_BASE_URL=http://localhost:8080
INTERNAL_API_TOKEN=dev-internal-token
TRACE_CALLBACK_ENABLED=true
PLATFORM_CALLS_ENABLED=true
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-your-api-key
AI_MODEL=deepseek-chat

# 火山方舟 doubao-embedding（memory-hybrid-retrieval 用）
ARK_BASE_URL=https://ark.cn-beijing.volces.com
ARK_API_KEY=ark-your-api-key
# 控制台「开通管理」里 doubao-embedding 文本模型的 Model ID / Endpoint ID
ARK_EMBEDDING_MODEL=doubao-embedding
# LanceDB 记忆库目录（嵌入式列式向量库）
MEMORY_LANCE_PATH=memory.lance
